{
  "routes": [
    {
      "src": "^/$",
      "has": [
        {
          "type": "host",
          "value": "atp-finals-2026.vercel.app"
        }
      ],
      "dest": "/api/atp-page"
    },
    {
      "src": "^/$",
      "has": [
        {
          "type": "host",
          "value": "tennisbyte.com"
        }
      ],
      "dest": "/api/atp-page"
    },
    {
      "src": "^/$",
      "dest": "/api/page"
    },
    {
      "src": "^/atp-finals-2026/?$",
      "dest": "/api/atp-page"
    },
    {
      "src": "^/atp-finals/?$",
      "status": 301,
      "headers": {
        "Location": "/atp-finals-2026/"
      }
    },
    {
      "src": "^/wta-finals/?$",
      "status": 301,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "^/about/?$",
      "dest": "/about.html"
    },
    {
      "src": "^/privacy/?$",
      "dest": "/privacy.html"
    },
    {
      "src": "^/terms/?$",
      "dest": "/terms.html"
    },
    {
      "src": "^/contact/?$",
      "dest": "/contact.html"
    },
    {
      "src": "^/rankings/?$",
      "dest": "/rankings.html"
    },
    {
      "src": "^/warm-up/?$",
      "dest": "/warm-up.html"
    },
    {
      "handle": "filesystem"
    }
  ],
  "functions": {
    "api/atp.js": {
      "includeFiles": "data/atp-snapshot.json"
    },
    "api/rankings.js": {
      "includeFiles": "data/rankings-snapshot.json"
    }
  }
}
