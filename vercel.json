{
  "routes": [
    {
      "src": "^/$",
      "dest": "/api/page"
    },
    {
      "src": "^/atp-finals-2026/?$",
      "dest": "/api/atp-page"
    },
    {
      "src": "^/atp-finals/?$",
      "status": 301,
      "headers": {
        "Location": "/atp-finals-2026/"
      }
    },
    {
      "src": "^/wta-finals/?$",
      "status": 301,
      "headers": {
        "Location": "/"
      }
    },
    {
      "handle": "filesystem"
    }
  ]
}